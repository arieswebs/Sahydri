# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT Secrets ─────────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_super_long_random_secret_at_least_64_chars_minimum_for_production_security_2026
JWT_REFRESH_SECRET=CHANGE_ME_another_super_long_random_secret_for_refresh_token_rotate_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Admin OTP ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@sahyadri.com
# Bcrypt-hashed password: bcrypt("admin123", 12) — update this in production!
ADMIN_PASSWORD_HASH=$2b$12$cbFLLiQI4XJIS8KNYXocceE42nMN0c0psrRO9WTi/vXCj/8OuQMn2
OTP_EXPIRES_MINUTES=10

# ─── Gmail SMTP (for sending OTP) ─────────────────────────────────────────────
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Create an App Password (select "Mail" + your device)
# 3. Paste the 16-char password below (spaces removed)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# ─── Security ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
